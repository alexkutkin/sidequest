---
import Icon from "./Icon.astro";
import Localized from "./Localized.astro";
import { agentInstructions, localizedLabel } from "../i18n";
import { defaultLanguage } from "../i18n/languages";
import { sitePath } from "../site";
const llmsPath = sitePath("llms.txt");
const llmsUrl = new URL(llmsPath, Astro.site).href;
---
<section class="night-hero">
  <div>
    <Localized as="p" class="eyebrow" message="eyebrow" />
    <h1><Localized message="title" /><br /><Localized class="title-accent" message="titleAccent" /></h1>
    <Localized as="p" class="night-intro" message="intro" />
  </div>
  <aside class="night-agent" id="agent-instructions">
    <Localized as="h2" message="agentTitle" />
    <Localized as="p" message="agentHint" />
    <div id="agent-router" class="agent-router" lang={defaultLanguage} role="note" {...localizedLabel("agentLabel")} data-llms-path={llmsPath}>{agentInstructions(llmsUrl, defaultLanguage)}</div>
    <button type="button" class="primary-button" data-copy-agent><Icon name="copy" /><Localized message="agentAction" /></button>
  </aside>
</section>
