---
import type { Prompt } from "../lib/catalogue";
import Icon from "./Icon.astro";
import TagButton from "./TagButton.astro";
import Disclosure from "./Disclosure.astro";
import { en } from "../i18n/en";
interface Props { prompt: Prompt; }
const { prompt } = Astro.props;
const { id, source } = prompt;
const content = prompt.content.en;
const stopped = source && source.update.state !== "current" ? source.update : null;
---
<article class="night-entry" data-prompt-id={id}>
  <div class="night-entry-line">
    <button type="button" class="entry-hit" data-expand={id} aria-label={`${en.readSummary}: ${content.title}`} aria-expanded="false" aria-controls={`summary-${id}`} aria-describedby={`subtitle-${id}`}></button>
    <span class="night-number">{String(prompt.order).padStart(2, "0")}</span>
    <div class="night-entry-main">
      <h2 class="entry-title" data-content="title">{content.title}</h2>
      <p id={`subtitle-${id}`} data-content="description">{content.description}</p>
      <div class="entry-meta cluster">
        <div class="entry-tags cluster">{prompt.tags.map(tag => <TagButton tag={tag} />)}</div>
        <span class="entry-byline">{prompt.author}</span>
      </div>
    </div>
    <span class="read-label" aria-hidden="true"><span data-summary-label>{en.readSummary}</span><span data-closed-icon><Icon name="chevron" /></span><span data-open-icon hidden><Icon name="close" /></span></span>
  </div>
  <Disclosure id={`summary-${id}`}>
    <div class="night-expanded">
      <section class="entry-summary">
        <h3 data-i18n="summary">{en.summary}</h3>
        <p data-content="summary">{content.summary}</p>
        <div class="entry-outcome">
          <h3 data-i18n="outcome">{en.outcome}</h3>
          <p data-content="outcome">{content.outcome}</p>
        </div>
      </section>
      {source && <div class="source-meta stack">
        <p><span data-i18n="snapshot">{en.snapshot}</span> <time datetime={source.savedAt} data-date={source.savedAt}>{source.savedAt}</time><span aria-hidden="true"> · </span><span data-i18n="revision">{en.revision}</span> <a href={`https://github.com/${source.owner}/${source.repo}/blob/${source.revision}/${source.path}`} target="_blank" rel="noreferrer">{source.revision.slice(0, 7)}</a><span aria-hidden="true"> · </span><a href={prompt.licensePath ?? ""} data-i18n="license">{en.license}</a></p>
        {stopped && <p class="source-status"><span data-i18n={stopped.state}>{en[stopped.state]}</span> <span data-i18n={stopped.reason}>{en[stopped.reason]}</span> <span data-i18n="checked">{en.checked}</span> <time datetime={stopped.checkedAt} data-date={stopped.checkedAt}>{stopped.checkedAt}</time>.</p>}
      </div>}
      <button type="button" class="full-toggle" data-full={id} aria-expanded="false" aria-controls={`full-${id}`}><span data-full-label>{en.fullPrompt}</span><Icon name="chevron" /></button>
      <Disclosure id={`full-${id}`}>
        <pre id={`text-${id}`} lang="en">{prompt.text}</pre>
      </Disclosure>
      <div class="prompt-actions cluster">
        <button type="button" class="primary-button" data-copy-prompt={id}><Icon name="copy" /><span data-i18n="copyPrompt">{en.copyPrompt}</span></button>
        <button type="button" class="text-button" data-copy-link={id}><Icon name="link" /><span data-i18n="copyLink">{en.copyLink}</span></button>
        {prompt.sourceUrl && <a class="text-button" href={prompt.sourceUrl} target="_blank" rel="noreferrer"><span data-i18n="original">{en.original}</span><Icon name="diagonal" /></a>}
      </div>
    </div>
  </Disclosure>
</article>
