---
import { localizedLabel } from "../i18n";
import { defaultLanguage, languages, type Language } from "../i18n/languages";
import { sitePath } from "../site";
const languageNames: Record<Language, string> = { en: "English", ru: "Русский" };
---
<header class="night-header cluster">
  <a class="brand" href={sitePath()} aria-label="Sidequest">
    <img class="brand-mark" src={sitePath("sidequest-mark.svg")} width="36" height="36" alt="" />Sidequest
  </a>
  <div class="language cluster" {...localizedLabel("languageLabel")}>
    {languages.map(language => <button type="button" data-language={language} lang={language} aria-label={languageNames[language]} aria-pressed={language === defaultLanguage}>{language.toUpperCase()}</button>)}
  </div>
</header>
