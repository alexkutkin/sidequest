---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PromptCard from "../components/PromptCard.astro";
import TagButton from "../components/TagButton.astro";
import Localized from "../components/Localized.astro";
import type { ClientPrompt } from "../catalogue";
import { getCatalogue } from "../lib/catalogue";
import { localizedLabel, promptCount } from "../i18n";
import { defaultLanguage } from "../i18n/languages";
const prompts = await getCatalogue();
const tags = [...new Set(prompts.flatMap(prompt => prompt.tags))];
const clientData: ClientPrompt[] = prompts.map(({ id, tags, content, rawPath }) => ({ id, tags, content, rawPath }));
const serialized = JSON.stringify(clientData).replace(/</g, "\\u003c");
---
<BaseLayout>
  <div class="after-hours center">
    <Header />
    <main>
      <Hero />
      <section class="night-list" {...localizedLabel("catalogue")}>
        <div class="night-list-top cluster">
          <nav class="tag-filters cluster" {...localizedLabel("filterLabel")}>
            <Localized class="tag-label" message="tags" />
            <TagButton tag="all" />
            {tags.map(tag => <TagButton tag={tag} />)}
          </nav>
          <span id="prompt-count" class="prompt-count">{promptCount(prompts.length, defaultLanguage)}</span>
        </div>
        {prompts.map(prompt => <PromptCard prompt={prompt} />)}
        <Localized as="p" class="night-list-bottom" message="note" />
      </section>
    </main>
    <footer class="site-footer cluster"><a href="https://alexkutkin.com/" target="_blank" rel="noreferrer">alexkutkin.com ↗</a></footer>
  </div>
  <script id="catalogue-data" type="application/json" set:html={serialized} />
</BaseLayout>
<script>
  import "../browser/catalogue";
</script>
